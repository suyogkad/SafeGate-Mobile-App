# Copy to .env on the VPS and fill in. Never commit the real file.
#
#   cp .env.production.example .env
#   nano .env
#
# Compose reads this one file twice: for the ${...} values below, and as the
# API container's own environment. So it carries both the deployment settings
# and the application's.
#
# Remember: setting one of the admin-console settings here (AI_PROVIDER,
# THERAPIST_AUTO_APPROVE, the model names, the limits) *pins* it and blocks
# editing in the console. Leave them out unless you mean to lock them.

# --- Where this is being served -----------------------------------------
# A subdomain you have already pointed at this server with a DNS A record.
# Caddy gets the HTTPS certificate for exactly this name, so it must resolve
# here before you start the stack.
API_DOMAIN=api.yourdomain.com
# Let's Encrypt emails this address if a certificate is about to expire.
ACME_EMAIL=you@yourdomain.com

# --- Database -----------------------------------------------------------
# Used to create the database and to build DATABASE_URL in docker-compose.yml.
# Generate the password, do not invent one:  openssl rand -base64 32
POSTGRES_USER=safegate
POSTGRES_PASSWORD=
POSTGRES_DB=safegate

# --- Auth ---------------------------------------------------------------
# Generate this too:  openssl rand -hex 48
# Changing it later signs everybody out, which is a fine way to revoke access.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI provider (keys only; the provider and models live in the console) ---
# Groq is api.groq.com and its keys begin "gsk_". It is NOT xAI's Grok
# (x.ai, keys begin "xai-") -- different companies, near-identical names.
GROQ_API_KEY=
# Only needed if you switch the console back to the Gemini fallback.
GOOGLE_API_KEY=

# --- Video (key only; the provider lives in the console) ----------------
DAILY_API_KEY=

# --- Who may call the API from a browser --------------------------------
# The admin console's own origin. A browser blocks the console otherwise.
# Vercel gives every preview deployment its own hostname, and those will be
# refused -- use the production URL, or attach your own subdomain to it.
# Comma-separated, no trailing slash, no spaces.
CORS_ORIGINS=https://admin.yourdomain.com

# --- App ----------------------------------------------------------------
# docker-compose.yml sets this to production as well; kept here for clarity.
ENVIRONMENT=production
