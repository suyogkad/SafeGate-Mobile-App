# Secrets and infrastructure only. Everything else (AI provider and models, companion
# limits, reminder lead time, safety country, video provider, therapist auto-approval)
# is managed in the admin console under System > Settings and stored in the database,
# so it can be changed without a redeploy. Built-in defaults are in app/config.py.
# Setting one of those keys here as a real environment variable pins it and blocks
# editing in the console -- useful for locking AI_PROVIDER=mock in CI.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://autism_user:changeme@localhost:5432/autism_support

# --- Auth ---
JWT_SECRET_KEY=changeme-generate-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI provider (key only; provider and models live in the admin console) ---
# Required before the console will let you switch the provider to "gemini".
GOOGLE_API_KEY=

# --- Video (key only; provider lives in the admin console) ---
# Required before the console will let you switch the provider to "daily".
DAILY_API_KEY=

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://localhost:19006
