# Caddy gets and renews the HTTPS certificate on its own, so there is no certbot
# step and nothing to remember to renew. It needs ports 80 and 443 open and
# API_DOMAIN already pointing at this server.
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip

	# The admin console runs on a different origin, so CORS matters -- and it is
	# answered by the application, which knows CORS_ORIGINS. Caddy must not add
	# its own CORS headers here or the browser sees two and rejects both.
	reverse_proxy api:8000

	# A child's recording is capped at 8 MB in the application; this leaves room
	# for the multipart envelope and refuses anything wildly larger at the edge.
	request_body {
		max_size 10MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format console
	}
}
